+/* These MT6895 cross-dispsys links are mux/mutex routing IDs, not devices. */
+static bool mtk_crtc_is_mt6895_dual_pipe_link(struct mtk_drm_private *priv,
+					    enum mtk_ddp_comp_id comp_id)
+{
+	if (priv->data->mmsys_id != MMSYS_MT6895)
+		return false;
+
+	switch (comp_id) {
+	case DDP_COMPONENT_DLO_ASYNC2:
+	case DDP_COMPONENT_DLO_ASYNC4:
+	case DDP_COMPONENT_DLI_ASYNC0:
+	case DDP_COMPONENT_DLI_ASYNC6:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool mtk_crtc_is_dual_pipe_virtual_comp(struct mtk_drm_private *priv,
+					      enum mtk_ddp_comp_id comp_id)
+{
+	return mtk_ddp_comp_get_type(comp_id) == MTK_DISP_VIRTUAL ||
+		mtk_crtc_is_mt6895_dual_pipe_link(priv, comp_id);
+}
