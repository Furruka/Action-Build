+static int mtk_usb_extcon_psy_get(struct mtk_extcon_info *extcon)
+{
+	struct device *dev = extcon->dev;
+	struct power_supply *psy;
+
+	if (!of_property_present(dev->of_node, "charger"))
+		return 0;
+
+	psy = devm_power_supply_get_by_phandle(dev, "charger");
+	if (!IS_ERR_OR_NULL(psy)) {
+		extcon->usb_psy = psy;
+		return 0;
+	}
+
+	/* BC1.2 supplies the sink data role when Type-C sink events are bypassed. */
+	if (extcon->bypss_typec_sink)
+		return dev_err_probe(dev, psy ? PTR_ERR(psy) : -EPROBE_DEFER,
+				     "waiting for charger power supply\n");
+
+	return 0;
+}
