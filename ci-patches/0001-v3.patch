diff -ruN -x *.dtb a/arch/arm64/Kconfig b/arch/arm64/Kconfig
--- a/arch/arm64/Kconfig	2026-11-25 18:30:12
+++ b/arch/arm64/Kconfig	2026-11-25 18:30:12
@@ -2338,6 +2338,40 @@
 
 menu "Boot options"
 
+config MTK_EMBED_BOARD_DTB
+	bool "Embed a pre-merged board DTB and override LK FDT at boot"
+	depends on OF
+	help
+	  MediaTek LK bootchains hand the kernel their own Android device tree.
+	  This option embeds a pre-merged .dtb file (no dtc at build time) and
+	  replaces initial_boot_params with it right after
+	  setup_machine_fdt(). LK's runtime-injected properties and
+	  /reserved-memory children are copied over first.
+
+config MTK_EMBED_BOARD_DTB_PATH
+	string "Path of the pre-merged DTB, relative to the kernel tree"
+	depends on MTK_EMBED_BOARD_DTB
+	default "arch/arm64/boot/dts/mediatek/qqcandy-merged.dtb"
+	help
+	  The file is copied to arch/arm64/kernel/board-embed.dtb and .incbin'ed.
+	  It must be a ready-to-use flattened DT (merge your base + overlays on
+	  the host with fdtoverlay first); the kernel build does not run dtc.
+
+config MTK_EMBED_DTB_LK_FDT_DUMP
+	bool "Keep a copy of LK's FDT and expose it at /sys/kernel/mtk_lk_fdt"
+	depends on MTK_EMBED_BOARD_DTB
+	help
+	  Saves the FDT LK passed us (post-LK FDT) into a static buffer, readable
+	  as a binary sysfs attribute. Needed to recover the real device tree on
+	  boards without UART.
+
+config MTK_EMBED_DTB_LK_FDT_MAX_KB
+	int "Max size of the saved LK FDT (KiB)"
+	depends on MTK_EMBED_DTB_LK_FDT_DUMP
+	default 1024
+	range 64 4096
+
+
 config ARM64_ACPI_PARKING_PROTOCOL
 	bool "Enable support for the ARM64 ACPI parking protocol"
 	depends on ACPI
diff -ruN -x *.dtb a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
--- a/arch/arm64/kernel/Makefile	2026-11-25 18:30:12
+++ b/arch/arm64/kernel/Makefile	2026-11-25 18:30:12
@@ -75,6 +75,15 @@
 $(obj)/vdso-wrap.o: $(obj)/vdso/vdso.so
 $(obj)/vdso32-wrap.o: $(obj)/vdso32/vdso.so
 
+# Embedded board DTB (v2): the DTB is a pre-merged file in the tree; the build
+# only copies it and .incbin's it. No dtc, no $(DTC) dependency.
+obj-$(CONFIG_MTK_EMBED_BOARD_DTB)		+= mtk_embed_dtb.o board_dtb.o
+$(obj)/board-embed.dtb: $(srctree)/$(CONFIG_MTK_EMBED_BOARD_DTB_PATH)
+	$(Q)cp -f $< $@
+$(obj)/board_dtb.o: $(obj)/board-embed.dtb
+targets += board-embed.dtb board_dtb.o
+
+
 obj-y					+= probes/
 obj-y					+= head.o
 extra-y					+= vmlinux.lds
diff -ruN -x *.dtb a/arch/arm64/kernel/board_dtb.S b/arch/arm64/kernel/board_dtb.S
--- a/arch/arm64/kernel/board_dtb.S	1970-01-01 08:00:00
+++ b/arch/arm64/kernel/board_dtb.S	2026-11-25 18:30:12
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * board_dtb.S - embed a pre-merged board DTB into the kernel image.
+ * v2: no build-time dtc; the DTB is a plain file in the tree (path from
+ * CONFIG_MTK_EMBED_BOARD_DTB_PATH), copied to $(obj)/board-embed.dtb by a cp
+ * rule and .incbin'ed here.
+ */
+	.section .rodata, "a"
+	.balign 8
+	.global _binary_arch_arm64_kernel_board_embed_dtb_start
+	.global _binary_arch_arm64_kernel_board_embed_dtb_end
+_binary_arch_arm64_kernel_board_embed_dtb_start:
+	.incbin "arch/arm64/kernel/board-embed.dtb"
+_binary_arch_arm64_kernel_board_embed_dtb_end:
+	.balign 8
diff -ruN -x *.dtb a/arch/arm64/kernel/mtk_embed_dtb.c b/arch/arm64/kernel/mtk_embed_dtb.c
--- a/arch/arm64/kernel/mtk_embed_dtb.c	1970-01-01 08:00:00
+++ b/arch/arm64/kernel/mtk_embed_dtb.c	2026-11-25 18:30:13
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * v3: embed a pre-merged board DTB and merge LK's runtime tree into it.
+ *
+ * Rules (stage11):
+ *   1. every node/property present in LK's tree but missing in ours is copied
+ *      verbatim (no fixed whitelist any more);
+ *   2. /memory reg + mblock_info always come from LK (machine specific);
+ *   3. /chosen: LK wins for bootargs/atag,devinfo/atag,boot; ours wins for
+ *      stdout-path/linux,stdout-path (we do not overwrite what we already have);
+ *   4. phandle/linux,phandle on copied nodes are dropped: LK numbers collide
+ *      with ours (stage11 host test: 33 duplicated values). Copied nodes are
+ *      leaf pin/config nodes that nothing references by phandle;
+ *   5. any failure is logged and the embedded tree is kept (never panic).
+ */
+#include <linux/acpi.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/libfdt.h>
+#include <linux/of_fdt.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+#include <asm/setup.h>
+
+#include "mtk_embed_dtb.h"
+
+/* 2 MiB: 542 KiB blob + 401 LK nodes + props, measured on lk.dtb (558 KiB) */
+#define MTK_BOARD_FDT_CAPACITY	SZ_2M
+#define MTK_FDT_HEADROOM	SZ_256K
+
+extern const u8 _binary_arch_arm64_kernel_board_embed_dtb_start[];
+extern const u8 _binary_arch_arm64_kernel_board_embed_dtb_end[];
+
+static u8 board_fdt[MTK_BOARD_FDT_CAPACITY] __aligned(8);
+
+#ifdef CONFIG_MTK_EMBED_DTB_LK_FDT_DUMP
+static u8 lk_fdt_copy[CONFIG_MTK_EMBED_DTB_LK_FDT_MAX_KB * 1024] __aligned(8);
+static unsigned int lk_fdt_size;
+
+static ssize_t mtk_lk_fdt_read(struct file *f, struct kobject *k,
+			       struct bin_attribute *a, char *buf,
+			       loff_t off, size_t count)
+{
+	if (off >= lk_fdt_size)
+		return 0;
+	if (off + count > lk_fdt_size)
+		count = lk_fdt_size - off;
+	memcpy(buf, lk_fdt_copy + off, count);
+	return count;
+}
+
+static struct bin_attribute mtk_lk_fdt_attr = {
+	.attr = { .name = "mtk_lk_fdt", .mode = 0444 },
+	.read = mtk_lk_fdt_read,
+};
+
+static int __init mtk_lk_fdt_sysfs_init(void)
+{
+	if (!lk_fdt_size)
+		return 0;
+	mtk_lk_fdt_attr.size = lk_fdt_size;
+	return sysfs_create_bin_file(kernel_kobj, &mtk_lk_fdt_attr);
+}
+late_initcall(mtk_lk_fdt_sysfs_init);
+
+static void __init mtk_save_lk_fdt(const void *lk)
+{
+	int size;
+
+	if (!lk || fdt_check_header(lk))
+		return;
+	size = fdt_totalsize(lk);
+	if (size <= 0 || size > sizeof(lk_fdt_copy))
+		return;
+	memcpy(lk_fdt_copy, lk, size);
+	lk_fdt_size = size;
+	pr_info("MTK-DTB: saved LK FDT %d bytes -> /sys/kernel/mtk_lk_fdt\n", size);
+}
+#else
+static void __init mtk_save_lk_fdt(const void *lk) { }
+#endif
+
+static int __init mtk_copy_props(const void *lk, int lk_off, void *dst, int d_off,
+				 bool skip_phandle)
+{
+	int i, len, ret = 0;
+	const char *name;
+
+	fdt_for_each_property_offset(i, lk, lk_off) {
+		const void *val;
+
+		val = fdt_getprop_by_offset(lk, i, &name, &len);
+		if (!val || len < 0)
+			continue;
+		if (skip_phandle && (!strcmp(name, "phandle") || !strcmp(name, "linux,phandle")))
+			continue;
+		if (fdt_setprop(dst, d_off, name, val, len))
+			ret = -FDT_ERR_NOSPACE;
+	}
+	return ret;
+}
+
+/* copy every node of LK's subtree that our tree does not have, recursively */
+static int __init mtk_merge_node(const void *lk, int lk_off, void *dst, int d_off,
+				 int *added, int *failed)
+{
+	int lk_child, d_child;
+
+	fdt_for_each_subnode(lk_child, lk, lk_off) {
+		const char *name = fdt_get_name(lk, lk_child, NULL);
+		int ret;
+
+		if (!name)
+			continue;
+		d_child = fdt_subnode_offset(dst, d_off, name);
+		if (d_child < 0) {
+			d_child = fdt_add_subnode(dst, d_off, name);
+			if (d_child < 0) {
+				(*failed)++;
+				continue;
+			}
+			if (mtk_copy_props(lk, lk_child, dst, d_child, true))
+				(*failed)++;
+			else
+				(*added)++;
+		}
+		if (mtk_merge_node(lk, lk_child, dst, d_child, added, failed))
+			(*failed)++;
+	}
+	return 0;
+}
+
+static int __init mtk_merge_memory(const void *lk, void *dst)
+{
+	static const char * const props[] = { "reg", "mblock_info" };
+	int lk_mem = fdt_path_offset(lk, "/memory");
+	int d_mem = fdt_path_offset(dst, "/memory");
+	int i;
+
+	if (lk_mem < 0)
+		return 0;
+	if (d_mem < 0)
+		d_mem = fdt_path_offset(dst, "/");
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		const void *val;
+		int len;
+
+		val = fdt_getprop(lk, lk_mem, props[i], &len);
+		if (val)
+			fdt_setprop(dst, d_mem, props[i], val, len);
+	}
+	return 0;
+}
+
+static int __init mtk_merge_chosen(const void *lk, void *dst)
+{
+	static const char * const lk_wins[] = { "bootargs", "atag,devinfo", "atag,boot" };
+	static const char * const ours_wins[] = { "stdout-path", "linux,stdout-path" };
+	int lk_ch = fdt_path_offset(lk, "/chosen");
+	int d_ch = fdt_path_offset(dst, "/chosen");
+	int i;
+
+	if (lk_ch < 0)
+		return 0;
+	if (d_ch < 0) {
+		int root = fdt_path_offset(dst, "/");
+
+		if (root < 0)
+			return root;
+		d_ch = fdt_add_subnode(dst, root, "chosen");
+		if (d_ch < 0)
+			return d_ch;
+	}
+	for (i = 0; i < ARRAY_SIZE(lk_wins); i++) {
+		const void *val;
+		int len;
+
+		val = fdt_getprop(lk, lk_ch, lk_wins[i], &len);
+		if (val)
+			fdt_setprop(dst, d_ch, lk_wins[i], val, len);
+	}
+	for (i = 0; i < ARRAY_SIZE(ours_wins); i++)
+		if (fdt_getprop(dst, d_ch, ours_wins[i], NULL))
+			pr_info("MTK-DTB: keeping our /chosen/%s\n", ours_wins[i]);
+	return 0;
+}
+
+void __init mtk_embed_dtb_early_init(void)
+{
+	const void *lk_fdt = initial_boot_params;
+	const u8 *emb = _binary_arch_arm64_kernel_board_embed_dtb_start;
+	size_t emb_size = _binary_arch_arm64_kernel_board_embed_dtb_end - emb;
+	int added = 0, failed = 0, ret;
+
+	if (!acpi_disabled)
+		return;
+
+	mtk_save_lk_fdt(lk_fdt);
+	pr_info("MTK-DTB: blob %zu bytes, buffer %zu\n", emb_size, sizeof(board_fdt));
+
+	if (!emb_size || emb_size + MTK_FDT_HEADROOM > sizeof(board_fdt)) {
+		pr_err("MTK-DTB: blob does not fit (%zu + %zu > %zu), keeping LK FDT\n",
+		       emb_size, (size_t)MTK_FDT_HEADROOM, sizeof(board_fdt));
+		return;
+	}
+	if (fdt_check_header(emb)) {
+		pr_err("MTK-DTB: blob invalid, keeping LK FDT\n");
+		return;
+	}
+	memcpy(board_fdt, emb, emb_size);
+	ret = fdt_open_into(board_fdt, board_fdt, sizeof(board_fdt));
+	if (ret) {
+		pr_err("MTK-DTB: fdt_open_into failed %d, keeping LK FDT\n", ret);
+		return;
+	}
+
+	ret = mtk_merge_memory(lk_fdt, board_fdt);
+	if (ret)
+		pr_warn("MTK-DTB: /memory merge failed %d\n", ret);
+	ret = mtk_merge_chosen(lk_fdt, board_fdt);
+	if (ret)
+		pr_warn("MTK-DTB: /chosen merge failed %d\n", ret);
+
+	mtk_merge_node(lk_fdt, fdt_path_offset(lk_fdt, "/") >= 0 ? 0 : 0, board_fdt, 0,
+		       &added, &failed);
+	pr_info("MTK-DTB: merged nodes added=%d failed=%d\n", added, failed);
+
+	initial_boot_params = board_fdt;
+	early_init_dt_scan_chosen(boot_command_line);
+	pr_info("MTK-DTB: runtime tree = embedded; cmdline=%s\n", boot_command_line);
+}
diff -ruN -x *.dtb a/arch/arm64/kernel/mtk_embed_dtb.h b/arch/arm64/kernel/mtk_embed_dtb.h
--- a/arch/arm64/kernel/mtk_embed_dtb.h	1970-01-01 08:00:00
