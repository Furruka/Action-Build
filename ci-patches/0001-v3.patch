+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_MTK_EMBED_DTB_H
+#define __ASM_MTK_EMBED_DTB_H
+
+#ifdef CONFIG_MTK_EMBED_BOARD_DTB
+void __init mtk_embed_dtb_early_init(void);
+#else
+static inline void __init mtk_embed_dtb_early_init(void) { }
+#endif
+
+#endif
