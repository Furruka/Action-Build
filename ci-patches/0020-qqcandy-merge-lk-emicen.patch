-/* LK adds the trained DRAM geometry and DVFS steps for the installed part. */
-static void __init mfdt_merge_dramc(struct mfdt_ctx *c)
-{
-	static const char path[] = "/soc/dramc@10230000";
-	static const char *const props[] = {
+static void __init mfdt_merge_compatible_props(struct mfdt_ctx *c, const char *path,
+					       const char *compatible,
+					       const char *const *props, size_t count)
+{
+	int lk = fdt_path_offset(c->lk, path);
+	int d = fdt_path_offset(c->dst, path);
+	size_t i;
+
+	if (lk < 0 || d < 0 ||
+	    fdt_node_check_compatible(c->lk, lk, compatible) ||
+	    fdt_node_check_compatible(c->dst, d, compatible))
+		return;
+
+	for (i = 0; i < count; i++) {
+		const void *val;
+		int len;
+
+		val = fdt_getprop(c->lk, lk, props[i], &len);
+		if (val)
+			mfdt_status(c, fdt_setprop(c->dst, d, props[i], val, len));
+	}
+}
+
+/* LK supplies trained geometry and DVFS steps for the installed DRAM. */
+static void __init mfdt_merge_dram(struct mfdt_ctx *c)
+{
+	static const char *const dramc_props[] = {
 		"dram_type", "support_ch_cnt", "ch_cnt", "rk_cnt", "mr_cnt",
 		"freq_cnt", "rk_size", "mr", "freq_step",
 	};
-	int lk = fdt_path_offset(c->lk, path);
-	int d = fdt_path_offset(c->dst, path);
-	size_t i;
-
-	if (lk < 0 || d < 0 ||
-	    fdt_node_check_compatible(c->lk, lk, "mediatek,mt6895-dramc") ||
-	    fdt_node_check_compatible(c->dst, d, "mediatek,mt6895-dramc"))
-		return;
-
-	for (i = 0; i < ARRAY_SIZE(props); i++) {
-		const void *val;
-		int len;
-
-		val = fdt_getprop(c->lk, lk, props[i], &len);
-		if (val)
-			mfdt_status(c, fdt_setprop(c->dst, d, props[i], val, len));
-	}
+	static const char *const emicen_props[] = { "ch_cnt", "rk_cnt", "rk_size" };
+
+	mfdt_merge_compatible_props(c, "/soc/dramc@10230000", "mediatek,mt6895-dramc",
+				    dramc_props, ARRAY_SIZE(dramc_props));
+	mfdt_merge_compatible_props(c, "/soc/emicen@10219000", "mediatek,mt6877-emicen",
+				    emicen_props, ARRAY_SIZE(emicen_props));
 }
 
