+static int qqcandy_power_off(struct drm_panel *panel)
+{
+	struct qqcandy_panel *ctx = to_qqcandy_panel(panel);
+	int ret;
+
+	if (!ctx->powered)
+		return 0;
+
+	gpiod_set_value_cansleep(ctx->bias_neg, 0);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->bias_pos, 0);
+	usleep_range(5000, 5100);
+	ret = regulator_disable(ctx->vufsldo);
+	if (!ret)
+		ctx->powered = false;
+	usleep_range(70000, 70100);
+	return ret;
+}
+
+static void qqcandy_release_supply(void *data)
+{
+	struct qqcandy_panel *ctx = data;
+
+	if (ctx->powered)
+		regulator_disable(ctx->vufsldo);
+}
+
+static int qqcandy_power_on(struct drm_panel *panel)
+{
+	struct qqcandy_panel *ctx = to_qqcandy_panel(panel);
+	int ret;
+
+	if (ctx->powered)
+		return 0;
+
+	usleep_range(5000, 5100);
+	ret = regulator_enable(ctx->vufsldo);
+	if (ret)
+		return ret;
+
+	ctx->powered = true;
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->bias_pos, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->bias_neg, 1);
+	usleep_range(5000, 5100);
+	ret = qqcandy_bias_configure();
+	if (ret) {
+		qqcandy_power_off(panel);
+		return ret;
+	}
+	usleep_range(5000, 5100);
+	return 0;
+}
+
+static int qqcandy_prepare(struct drm_panel *panel)
+{
+	struct qqcandy_panel *ctx = to_qqcandy_panel(panel);
+	const u8 brightness[] = {
+		MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+		qqcandy_brightness >> 8, qqcandy_brightness & 0xff,
+	};
+	int ret;
+
+	ret = qqcandy_power_on(panel);
+	if (ret)
+		return ret;
+
+	usleep_range(12000, 12100);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(15000, 15100);
+
+	ctx->transfer_error = 0;
+	qqcandy_panel_init(ctx);
+	qqcandy_dsi_write(ctx, brightness, sizeof(brightness));
+	ret = ctx->transfer_error;
+	if (ret) {
+		gpiod_set_value_cansleep(ctx->reset, 0);
+		qqcandy_power_off(panel);
+	}
+	return ret;
+}
+
+static int qqcandy_unprepare(struct drm_panel *panel)
+{
+	struct qqcandy_panel *ctx = to_qqcandy_panel(panel);
+
+	ctx->transfer_error = 0;
+	qqcandy_dsi_write_seq(ctx, MIPI_DCS_SET_DISPLAY_OFF);
+	usleep_range(25000, 25100);
+	qqcandy_dsi_write_seq(ctx, MIPI_DCS_ENTER_SLEEP_MODE);
+	usleep_range(70000, 70100);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(5000, 5100);
+
+	/* The DSI host disables link clocks before calling panel_poweroff. */
+	return 0;
+}
+
+static int qqcandy_reset(struct drm_panel *panel, int on)
+{
+	struct qqcandy_panel *ctx = to_qqcandy_panel(panel);
+
+	gpiod_set_value_cansleep(ctx->reset, on);
+	return 0;
+}
