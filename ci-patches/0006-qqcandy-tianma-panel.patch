+		0x00, 0x95, 0x00, 0xa9, 0x00, 0xbb };
+	const u8 bl_tb7[] = { 0xb1, 0x00, 0xcc, 0x01, 0x06, 0x01, 0x2e, 0x01, 0x70, 0x01, 0x9e,
+		0x01, 0xe9, 0x02, 0x22, 0x02, 0x24 };
+	const u8 bl_tb8[] = { 0xb2, 0x02, 0x5b, 0x02, 0x99, 0x02, 0xc3, 0x02, 0xf7, 0x03, 0x1b,
+		0x03, 0x43, 0x03, 0x52, 0x03, 0x5f };
+	const u8 bl_tb9[] = { 0xb3, 0x03, 0x70, 0x03, 0x82, 0x03, 0x98, 0x03, 0xac, 0x03, 0xd0,
+		0x03, 0xd8, 0x00, 0x00 };
+
+	cb(dsi, handle, bl_tb1, ARRAY_SIZE(bl_tb1));
+	cb(dsi, handle, bl_tb2, ARRAY_SIZE(bl_tb2));
+	cb(dsi, handle, bl_tb3, ARRAY_SIZE(bl_tb3));
+	cb(dsi, handle, bl_tb4, ARRAY_SIZE(bl_tb4));
+	cb(dsi, handle, bl_tb5, ARRAY_SIZE(bl_tb5));
+	cb(dsi, handle, bl_tb1, ARRAY_SIZE(bl_tb1));
+	cb(dsi, handle, bl_tb2, ARRAY_SIZE(bl_tb2));
+
+	cb(dsi, handle, bl_tb6, ARRAY_SIZE(bl_tb6));
+	cb(dsi, handle, bl_tb7, ARRAY_SIZE(bl_tb7));
+	cb(dsi, handle, bl_tb8, ARRAY_SIZE(bl_tb8));
+	cb(dsi, handle, bl_tb9, ARRAY_SIZE(bl_tb9));
+}
+
+static void qqcandy_cabc_switch(void *dsi, dcs_write_gce cb, void *handle,
+			       unsigned int level)
+{
+	const u8 page[] = { 0xff, 0x10 };
+	const u8 unlock[] = { 0xfb, 0x01 };
+	const u8 dimming[] = { 0x53, 0x2c };
+	const u8 cabc[] = { 0x55, level };
+
+	if (!cb || level > 3)
+		return;
+
+	cb(dsi, handle, page, sizeof(page));
+	cb(dsi, handle, unlock, sizeof(unlock));
+	if (qqcandy_dimming)
+		cb(dsi, handle, dimming, sizeof(dimming));
+	cb(dsi, handle, cabc, sizeof(cabc));
+	qqcandy_cabc = level;
+}
+
+static int qqcandy_set_backlight(void *dsi, dcs_write_gce cb, void *handle,
+			       unsigned int level)
+{
+	const u8 page[] = { 0xff, 0x10 };
+	const u8 unlock[] = { 0xfb, 0x01 };
+	const u8 dimming_off[] = { 0x53, 0x24 };
+	const u8 dimming_on[] = { 0x53, 0x2c };
+	const u8 backlight_off[] = { 0x53, 0x0c };
+	const u8 pwm_off[] = { 0x68, 0x01, 0x01 };
+	const u8 cabc[] = { 0x55, qqcandy_cabc };
+	u8 brightness[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0, 0 };
+
+	if (!cb)
+		return -EINVAL;
+
+	level = min_t(unsigned int, level, QQCANDY_MAX_BRIGHTNESS);
+	if (level && level < 14 && !qqcandy_low_gamma) {
+		qqcandy_gamma_enter(dsi, cb, handle);
+		qqcandy_low_gamma = true;
+	} else if (level >= 14 && qqcandy_low_gamma) {
+		qqcandy_gamma_exit(dsi, cb, handle);
+		qqcandy_low_gamma = false;
+	} else if (!level) {
+		qqcandy_low_gamma = false;
+	}
+
+	cb(dsi, handle, page, sizeof(page));
+	cb(dsi, handle, unlock, sizeof(unlock));
+	if (!level) {
+		qqcandy_dimming = false;
+		cb(dsi, handle, pwm_off, sizeof(pwm_off));
+		cb(dsi, handle, backlight_off, sizeof(backlight_off));
+	} else if (qqcandy_dimming) {
+		cb(dsi, handle, dimming_on, sizeof(dimming_on));
+		qqcandy_dimming = false;
+	}
+
+	if (!qqcandy_brightness) {
+		usleep_range(15000, 15100);
+		if (qqcandy_cabc)
+			cb(dsi, handle, cabc, sizeof(cabc));
+		if (qqcandy_cabc == 3)
+			cb(dsi, handle, dimming_on, sizeof(dimming_on));
+		else
+			cb(dsi, handle, dimming_off, sizeof(dimming_off));
+		qqcandy_dimming = true;
+	}
+
+	brightness[1] = level >> 8;
+	brightness[2] = level & 0xff;
+	cb(dsi, handle, brightness, sizeof(brightness));
+	qqcandy_brightness = level;
+	return 0;
+}
+
+static int qqcandy_restore_backlight(void *dsi, dcs_write_gce cb, void *handle)
+{
+	const u8 brightness[] = {
+		MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+		qqcandy_brightness >> 8, qqcandy_brightness & 0xff,
+	};
+
+	if (!cb)
+		return -EINVAL;
+	cb(dsi, handle, brightness, sizeof(brightness));
+	return 1;
+}
+
+/* The board uses identical link and DSC parameters across all modes. */
+static int qqcandy_ext_param_get(struct drm_panel *panel, struct drm_connector *connector,
+				struct mtk_panel_params **params, unsigned int mode)
+{
+	*params = &qqcandy_params;
+	return 0;
+}
+
+static struct mtk_panel_funcs qqcandy_ext_funcs = {
+	.reset = qqcandy_reset,
+	.set_backlight_cmdq = qqcandy_set_backlight,
+	.ext_param_get = qqcandy_ext_param_get,
+	.panel_poweron = qqcandy_power_on,
+	.panel_poweroff = qqcandy_power_off,
+	.esd_backlight_recovery = qqcandy_restore_backlight,
+	.cabc_switch = qqcandy_cabc_switch,
+};
+
+static int qqcandy_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(qqcandy_modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, &qqcandy_modes[i]);
+		if (!mode)
+			return i ? (int)i : -ENOMEM;
+
+		drm_mode_set_name(mode);
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (!i)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = 68;
+	connector->display_info.height_mm = 153;
+	return ARRAY_SIZE(qqcandy_modes);
+}
+
+static const struct drm_panel_funcs qqcandy_panel_funcs = {
+	.prepare = qqcandy_prepare,
+	.unprepare = qqcandy_unprepare,
+	.get_modes = qqcandy_get_modes,
+};
+
+static int qqcandy_setup_gpio(struct gpio_desc *gpio, int *level)
+{
+	int ret;
+
+	if (IS_ERR(gpio))
+		return PTR_ERR(gpio);
+
+	ret = gpiod_get_value_cansleep(gpio);
+	if (ret < 0)
+		return ret;
+
+	*level = ret;
+	return gpiod_direction_output(gpio, *level);
+}
+
+static int qqcandy_dsi_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct device_node *host, *endpoint, *remote;
+	struct mtk_panel_ctx *ext;
+	struct qqcandy_panel *ctx;
+	int reset, bias_pos, bias_neg;
+	int ret;
+
+	host = of_get_parent(dev->of_node);
+	if (!host)
+		return -ENODEV;
+	endpoint = of_graph_get_next_endpoint(host, NULL);
+	of_node_put(host);
+	if (!endpoint)
+		return -ENODEV;
+	remote = of_graph_get_remote_port_parent(endpoint);
+	of_node_put(endpoint);
+	ret = remote == dev->of_node ? 0 : -ENODEV;
+	of_node_put(remote);
+	if (ret)
+		return ret;
+
+	mutex_lock(&qqcandy_bias_lock);
+	ret = qqcandy_bias_client ? 0 : -EPROBE_DEFER;
+	mutex_unlock(&qqcandy_bias_lock);
+	if (ret)
+		return dev_err_probe(dev, ret, "LCD bias controller unavailable\n");
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->vufsldo = devm_regulator_get(dev, "vufsldo");
+	if (IS_ERR(ctx->vufsldo))
+		return dev_err_probe(dev, PTR_ERR(ctx->vufsldo), "failed to get vufsldo\n");
+	ret = regulator_set_voltage(ctx->vufsldo, 1800000, 1800000);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set vufsldo voltage\n");
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	ret = qqcandy_setup_gpio(ctx->reset, &reset);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get reset GPIO\n");
+
+	ctx->bias_pos = devm_gpiod_get_index(dev, "bias", 0, GPIOD_ASIS);
+	ret = qqcandy_setup_gpio(ctx->bias_pos, &bias_pos);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get positive bias GPIO\n");
+
+	ctx->bias_neg = devm_gpiod_get_index(dev, "bias", 1, GPIOD_ASIS);
+	ret = qqcandy_setup_gpio(ctx->bias_neg, &bias_neg);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get negative bias GPIO\n");
+
+	drm_panel_init(&ctx->panel, dev, &qqcandy_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+
+	/* Keep the live LK scanout when the panel rails and reset are active. */
+	if (reset && bias_pos && bias_neg) {
+		ret = regulator_enable(ctx->vufsldo);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to keep vufsldo enabled\n");
+		ctx->powered = true;
+		ret = qqcandy_bias_configure();
+		if (ret) {
+			regulator_disable(ctx->vufsldo);
+			return dev_err_probe(dev, ret, "failed to configure LCD bias\n");
+		}
+		ctx->panel.prepared = true;
+		ctx->panel.enabled = true;
+	}
+
+	ret = devm_add_action_or_reset(dev, qqcandy_release_supply, ctx);
+	if (ret)
+		return ret;
+
+	ret = mtk_panel_ext_create(dev, &qqcandy_params, &qqcandy_ext_funcs, &ctx->panel);
+	if (ret)
+		return ret;
+
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		ext = find_panel_ctx(&ctx->panel);
+		mtk_panel_detach(ext);
+		mtk_panel_remove(ext);
+		return dev_err_probe(dev, ret, "failed to attach Tianma panel to DSI\n");
+	}
+
+	dev_info(dev, "QQcandy Tianma NT36672C attached (%s)\n",
+		 ctx->panel.prepared ? "LK handoff" : "cold initialization");
+	return 0;
+}
+
+static void qqcandy_dsi_remove(struct mipi_dsi_device *dsi)
+{
+	struct qqcandy_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	struct mtk_panel_ctx *ext = find_panel_ctx(&ctx->panel);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+	mtk_panel_detach(ext);
+	mtk_panel_remove(ext);
+}
+
+static const struct of_device_id qqcandy_dsi_of_match[] = {
+	{ .compatible = "oplus21143,tianma,nt36672c,vdo" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qqcandy_dsi_of_match);
+
+static struct mipi_dsi_driver qqcandy_dsi_driver = {
+	.probe = qqcandy_dsi_probe,
+	.remove = qqcandy_dsi_remove,
+	.driver = {
+		.name = "oplus21143_tianma_nt36672c_dsi_vdo",
+		.of_match_table = qqcandy_dsi_of_match,
+	},
+};
+
+static int __init qqcandy_panel_module_init(void)
+{
+	int ret;
+
+	ret = i2c_add_driver(&qqcandy_bias_driver);
+	if (ret)
+		return ret;
+
+	mtk_panel_lock();
+	ret = mipi_dsi_driver_register(&qqcandy_dsi_driver);
+	mtk_panel_unlock();
+	if (ret)
+		i2c_del_driver(&qqcandy_bias_driver);
+	return ret;
+}
+module_init(qqcandy_panel_module_init);
+
+static void __exit qqcandy_panel_module_exit(void)
+{
+	mtk_panel_lock();
+	mipi_dsi_driver_unregister(&qqcandy_dsi_driver);
+	mtk_panel_unlock();
+	i2c_del_driver(&qqcandy_bias_driver);
+}
+module_exit(qqcandy_panel_module_exit);
+
+MODULE_DESCRIPTION("OPPO 21143/22801 Tianma NT36672C DSI panel");
