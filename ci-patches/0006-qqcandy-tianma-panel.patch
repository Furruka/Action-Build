+#define QQCANDY_BIAS_ADDR 0x3e
+#define QQCANDY_DEFAULT_BRIGHTNESS 1023
+#define QQCANDY_MAX_BRIGHTNESS 4095
+
+struct qqcandy_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *vufsldo;
+	struct gpio_desc *reset;
+	struct gpio_desc *bias_pos;
+	struct gpio_desc *bias_neg;
+	bool powered;
+	int transfer_error;
+};
+
+/* The stock board describes one LCD bias controller on a separate bus. */
+static DEFINE_MUTEX(qqcandy_bias_lock);
+static struct i2c_client *qqcandy_bias_client;
+
+static int qqcandy_bias_probe(struct i2c_client *client)
+{
+	int ret = 0;
+
+	if (client->addr != QQCANDY_BIAS_ADDR)
+		return -ENODEV;
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -EOPNOTSUPP;
+
+	mutex_lock(&qqcandy_bias_lock);
+	if (qqcandy_bias_client)
+		ret = -EBUSY;
+	else
+		qqcandy_bias_client = client;
+	mutex_unlock(&qqcandy_bias_lock);
+
+	return ret;
+}
+
+static void qqcandy_bias_remove(struct i2c_client *client)
+{
+	mutex_lock(&qqcandy_bias_lock);
+	qqcandy_bias_client = NULL;
+	mutex_unlock(&qqcandy_bias_lock);
+}
+
+static const struct of_device_id qqcandy_bias_of_match[] = {
+	{ .compatible = "mediatek,I2C_LCD_BIAS" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qqcandy_bias_of_match);
+
+static struct i2c_driver qqcandy_bias_driver = {
+	.probe = qqcandy_bias_probe,
+	.remove = qqcandy_bias_remove,
+	.driver = {
+		.name = "qqcandy-lcd-bias",
+		.of_match_table = qqcandy_bias_of_match,
+	},
+};
+
+static int qqcandy_bias_configure(void)
+{
+	const u8 value[] = { 0x03, 0x43 };
+	int ret = -EPROBE_DEFER;
+
+	mutex_lock(&qqcandy_bias_lock);
+	if (qqcandy_bias_client) {
+		ret = i2c_master_send(qqcandy_bias_client, value, sizeof(value));
+		if (ret == (int)sizeof(value))
+			ret = 0;
+		else if (ret >= 0)
+			ret = -EIO;
+	}
+	mutex_unlock(&qqcandy_bias_lock);
+
+	return ret;
+}
+
+static struct qqcandy_panel *to_qqcandy_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct qqcandy_panel, panel);
+}
+
+static void qqcandy_dsi_write(struct qqcandy_panel *ctx, const u8 *data, size_t len)
+{
+	ssize_t ret;
+
+	if (ctx->transfer_error)
+		return;
+
+	if (data[0] < 0xb0)
+		ret = mipi_dsi_dcs_write_buffer(ctx->dsi, data, len);
+	else
+		ret = mipi_dsi_generic_write(ctx->dsi, data, len);
+
+	if (ret < 0) {
+		dev_err(&ctx->dsi->dev, "panel command %#x failed: %zd\n", data[0], ret);
+		ctx->transfer_error = ret;
+	}
+}
+
+#define qqcandy_dsi_write_seq(ctx, ...) do {				\
+	static const u8 data[] = { __VA_ARGS__ };				\
+	qqcandy_dsi_write(ctx, data, ARRAY_SIZE(data));			\
+} while (0)
