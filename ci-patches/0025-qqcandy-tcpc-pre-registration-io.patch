diff --git a/kernel/kernel_device_modules-6.12/drivers/misc/mediatek/typec/tcpc/tcpc_mt6375.c b/kernel/kernel_device_modules-6.12/drivers/misc/mediatek/typec/tcpc/tcpc_mt6375.c
