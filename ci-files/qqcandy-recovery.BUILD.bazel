# The MT6895 board DT connects display through the MMSYS clock controllers,
# SCPSYS, SMI, display IOMMU, MMQoS, command queue and MML. Include DT
# suppliers explicitly because Linux module dependencies describe symbols.
_DISPLAY = [
    "drivers/clk/mediatek:clk-mt6895-cam",
    "drivers/clk/mediatek:clk-mt6895-ccu",
    "drivers/clk/mediatek:clk-mt6895-img",
    "drivers/clk/mediatek:clk-mt6895-mdpsys",
    "drivers/clk/mediatek:clk-mt6895-mmsys",
    "drivers/clk/mediatek:clk-mt6895-vcodec",
    "drivers/devfreq:mtk-dvfsrc-devfreq",
    "drivers/gpu/drm/mediatek/mediatek_v2:mediatek-drm",
    "drivers/gpu/drm/mediatek/mediatek_v2:mtk_panel_ext",
    "drivers/gpu/drm/mediatek/mml:mtk-mml-mt6895",
    "drivers/gpu/drm/panel:oplus21143_tianma_nt36672c_dsi_vdo",
    "drivers/interconnect/mediatek:mmqos-mt6895",
    "drivers/interconnect/mediatek:mtk-emi",
    "drivers/iommu:mtk_iommu",
    "drivers/leds:leds-mtk-disp",
    "drivers/pwm:pwm-mtk-disp",
    "drivers/regulator:mtk-dvfsrc-regulator",
    "drivers/soc/mediatek:mtk-dvfsrc",
    "drivers/soc/mediatek:mtk-scpsys-mt6895",
]

# kernel_modules_install only collects a DDK target's own output. Include
# the display targets' DDK dependencies explicitly so depmod sees their
# symbols. Recovery packaging then selects the actual loadable closure.
_DISPLAY_DEPENDENCIES = [
    "drivers/dma-buf/heaps:oplus_boost_pool_mtk",
    "drivers/dma-buf/heaps:oplus_bsp_aizerofs",
    "drivers/dma-buf/heaps:oplus_bsp_mm_osvelte",
    "drivers/dma-buf/heaps:system_heap",
    "drivers/gpu/drm/mediatek/mediatek_v2:mtk_disp_notify",
    "drivers/gpu/drm/mediatek/mediatek_v2:mtk_sync",
    "drivers/gpu/drm/mediatek/mml:mtk-mml",
    "drivers/interconnect/mediatek:mmqos-common",
    "drivers/leds:leds-mtk",
    "drivers/memory:mtk-smi",
    "drivers/memory/mediatek:emi",
    "drivers/memory/mediatek:emi-mpu",
    "drivers/memory/mediatek:mtk_dramc",
    "drivers/misc/mediatek/boot_common:mtk_boot_common",
    "drivers/misc/mediatek/clkbuf:clkbuf",
    "drivers/misc/mediatek/cmdq/mailbox:mtk-cmdq-drv-ext",
    "drivers/misc/mediatek/cmdq/mailbox:cmdq-platform-mt6895",
    "drivers/misc/mediatek/hwccf:hwccf",
    "drivers/misc/mediatek/iommu:iommu_debug",
    "drivers/misc/mediatek/iommu:iommu_secure",
    "drivers/misc/mediatek/iommu:mtk_iommu_util",
    "drivers/misc/mediatek/mmdvfs:mtk-mmdvfs-debug",
    "drivers/misc/mediatek/mme:mme",
    "drivers/misc/mediatek/mminfra:mtk-mminfra-debug",
    "drivers/misc/mediatek/mminfra:mtk-mminfra-util",
    # These platform modules export the same symbols. Install only this SoC
    # so depmod cannot select a foreign implementation by traversal order.
    "drivers/misc/mediatek/mm_monitor:mm-monitor-platform-mt6895",
    "drivers/misc/mediatek/mm_monitor:mtk-mm-monitor-controller",
    "drivers/misc/mediatek/mmdebug:mtk-mmdebug-vcp-stub",
    "drivers/misc/mediatek/mmp/src:mmprofile",
