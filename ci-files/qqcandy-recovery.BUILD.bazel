# Install as qqcandy_recovery/BUILD.bazel in the synchronized kernel workspace.
# The device kernel and the Image must use identical Kleaf flags.

load("//build/kernel/kleaf:kernel.bzl", "kernel_modules_install")

_DEVICE_MODULES = "//kernel_device_modules-6.12"
_VARIANT = ".mgk_64_k612.6.12.user"

_USB = [
    "drivers/clk/mediatek:clk-common",
    "drivers/clk/mediatek:clk-mt6895",
