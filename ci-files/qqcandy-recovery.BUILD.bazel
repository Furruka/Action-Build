    "drivers/misc/mediatek/vcp/rv:vcp_status",
    "drivers/rpmsg:mtk_rpmsg_mbox",
    "drivers/soc/mediatek/devapc:device-apc-common",
    "drivers/soc/mediatek:mtk-mbox",
    "drivers/soc/mediatek:mtk-mmdvfs",
    "drivers/soc/mediatek:mtk-mmdvfs-v3",
    "drivers/soc/mediatek:mtk-scpsys",
    "drivers/soc/mediatek:mtk_tinysys_ipi",
    "drivers/soc/oplus/boot:buildvariant",
    "drivers/soc/oplus/boot:oplus_bsp_boot_projectinfo",
    "drivers/soc/oplus/boot:oplusboot",
    "sound/soc/mediatek/common:mtk-afe-external",
]

kernel_modules_install(
    name = "qqcandy_recovery_modules_install",
    kernel_build = _DEVICE_MODULES + ":mgk_64_k612.user",
    kernel_modules = [
        _DEVICE_MODULES + "/" + module + _VARIANT
        for module in _USB + _DISPLAY + _DISPLAY_DEPENDENCIES
    ],
    outs = [
        "modules.alias",
        "modules.builtin",
        "modules.dep",
        "modules.softdep",
        "modules.symbols",
    ],
)
